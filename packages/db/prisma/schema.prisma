  lastLogin          DateTime?            @map("last_login")
  loginAttempts      Int                  @default(0) @map("login_attempts")
  lockedUntil        DateTime?            @map("locked_until")
  createdAt          DateTime             @default(now()) @map("created_at")
  accounts           Account[]
  auditLogs          AuditLogs[]
  conceptDriftAlerts ConceptDriftAlerts[]
  contestSubmissions ContestSubmission[]
  events             Events[]
  exerciseAttempts   ExerciseAttempt[]
  learningContracts  LearningContracts[]
  learningMilestones LearningMilestones[]
  mistakeCards       MistakeCards[]
  onboardingProfile  OnboardingProfile?
  personalBests      PersonalBests[]
  problemReports     ProblemReports[]
  reviewCards        ReviewCards[]
  sessions           Session[]
  starterTasks       StarterTasks[]
  submissions        Submission[]
  userBadges         UserBadges[]
  userKnowledgeGraph UserKnowledgeGraph[]
  userSubjects       UserSubject[]
