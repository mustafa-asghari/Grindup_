// =====================
// SOCIAL & CHALLENGES
// =====================

model Friendship {
  id          String           @id @default(uuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  status      FriendshipStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  requester   User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

model DirectMessage {
  id         String   @id @default(uuid())
  senderId   String   @map("sender_id")
  receiverId String   @map("receiver_id")
  content    String
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessagesReceived", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@map("direct_messages")
}

model StudyChallenge {
  id            String          @id @default(uuid())
  challengerId  String          @map("challenger_id")
  challengedId  String          @map("challenged_id")
  challengeType ChallengeType
  xpStake       Int             @default(50) @map("xp_stake")
  targetValue   Int             @map("target_value") // e.g., 60 mins, 100 XP, 5 exercises
  targetProblemId String?       @map("target_problem_id")
  duration      Int             @default(24) // hours
  status        ChallengeStatus @default(pending)
  winnerId      String?         @map("winner_id")
  startsAt      DateTime?       @map("starts_at")
  endsAt        DateTime?       @map("ends_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  challenger    User              @relation("ChallengesSent", fields: [challengerId], references: [id], onDelete: Cascade)
  challenged    User              @relation("ChallengesReceived", fields: [challengedId], references: [id], onDelete: Cascade)
  winner        User?             @relation("ChallengesWon", fields: [winnerId], references: [id])
  results       ChallengeResult[]

  @@map("study_challenges")
}

model ChallengeResult {
  id          String   @id @default(uuid())
  challengeId String   @map("challenge_id")
  userId      String   @map("user_id")
  score       Int      @default(0)
  progress    Json?    // { studyMins: 45, exercisesDone: 3, xpEarned: 80 }
  updatedAt   DateTime @updatedAt @map("updated_at")

  challenge StudyChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@map("challenge_results")
}

enum FriendshipStatus {
  pending
  accepted
  blocked
}

enum ChallengeType {
  study_time    // Who studies more minutes
  xp_race       // Who earns more XP
  exercise_count // Who completes more exercises
  quiz_score    // Who gets higher quiz average
  leetcode_race // Who solves a problem first
}

enum ChallengeStatus {
  pending
  accepted
  active
  completed
  cancelled
}
