generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String? @map("session_state")
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model AuditLogs {
  id          String   @id
  adminId     String   @map("admin_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [adminId], references: [id])

  @@map("audit_logs")
}

model Badges {
  id          String       @id
  name        String
  description String?
  iconUrl     String?      @map("icon_url")
  criteria    Json?
  userBadges  UserBadges[]

  @@map("badges")
}

model CatchupQueues {
  id                 String             @id
  userId             String             @map("user_id")
  homeworkId         String             @map("homework_id")
  missedAt           DateTime           @map("missed_at")
  priority           Int                @default(5)
  rescheduledTo      DateTime?          @map("rescheduled_to")
  completed          Boolean            @default(false)
  homeworkAssignment HomeworkAssignment @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@map("catchup_queues")
}

model Certificates {
  id               String   @id
  userId           String   @map("user_id")
  type             String
  title            String
  issuedAt         DateTime @default(now()) @map("issued_at")
  verificationCode String   @unique @map("verification_code")

  @@map("certificates")
}

model ConceptDriftAlerts {
  id              String   @id
  userId          String   @map("user_id")
  topicId         String   @map("topic_id")
  masteryBefore   Float    @map("mastery_before")
  masteryCurrent  Float    @map("mastery_current")
  driftPercentage Float    @map("drift_percentage")
  alertedAt       DateTime @default(now()) @map("alerted_at")
  user            User     @relation(fields: [userId], references: [id])

  @@map("concept_drift_alerts")
}

model ContestIntegrityFlags {
  id        String   @id
  contestId String   @map("contest_id")
  userId    String   @map("user_id")
  flagType  String   @map("flag_type")
  severity  String   @default("warning")
  details   Json?
  reviewed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contest_integrity_flags")
}

model ContestProblems {
  contestId String  @map("contest_id")
  problemId String  @map("problem_id")
  points    Int
  order     Int
  contest   Contest @relation(fields: [contestId], references: [id])
  problem   Problem @relation(fields: [problemId], references: [id])

  @@id([contestId, problemId])
  @@map("contest_problems")
}

model ContestSubmission {
  id             String     @id
  contestId      String     @map("contest_id")
  userId         String     @map("user_id")
  problemId      String     @map("problem_id")
  submissionId   String     @map("submission_id")
  penaltyMinutes Int        @default(0) @map("penalty_minutes")
  submittedAt    DateTime   @default(now()) @map("submitted_at")
  contest        Contest    @relation(fields: [contestId], references: [id])
  submission     Submission @relation(fields: [submissionId], references: [id])
  user           User       @relation(fields: [userId], references: [id])

  @@map("contest_submissions")
}

model ContestUpsolves {
  id         String    @id
  contestId  String    @map("contest_id")
  userId     String    @map("user_id")
  problemId  String    @map("problem_id")
  unlockedAt DateTime  @default(now()) @map("unlocked_at")
  solvedAt   DateTime? @map("solved_at")

  @@map("contest_upsolves")
}

model Contest {
  id                String              @id
  title             String
  startsAt          DateTime            @map("starts_at")
  endsAt            DateTime            @map("ends_at")
  isRated           Boolean             @default(true) @map("is_rated")
  penaltyPerWrong   Int                 @default(5) @map("penalty_per_wrong")
  contestProblems   ContestProblems[]
  contestSubmission ContestSubmission[]
  contestExercises  ContestExercise[]
  participants      ContestParticipant[]
  messages          ContestMessage[]
  createdById       String?              @map("created_by_id")
  createdBy         User?                @relation("CreatedContests", fields: [createdById], references: [id])

  @@map("contests")
}

model ContestMessage {
  id        String   @id @default(uuid())
  contestId String   @map("contest_id")
  userId    String   @map("user_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")
  contest   Contest  @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contest_messages")
  @@index([contestId])
}

model ContestExercise {
  contestId  String   @map("contest_id")
  exerciseId String   @map("exercise_id")
  points     Int
  order      Int
  contest    Contest  @relation(fields: [contestId], references: [id])
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  @@id([contestId, exerciseId])
  @@map("contest_exercises")
}

model ContestParticipant {
   id        String   @id @default(uuid())
   contestId String   @map("contest_id")
   userId    String   @map("user_id")
   joinedAt  DateTime @default(now()) @map("joined_at")
   contest   Contest  @relation(fields: [contestId], references: [id])
   user      User     @relation(fields: [userId], references: [id])

   @@unique([contestId, userId])
   @@map("contest_participants")
}

enum ContestLobbyVisibility {
  PUBLIC
  PRIVATE
}

enum ContestLobbyRole {
  HOST
  MEMBER
}

enum ContestLobbyMode {
  LEETCODE_RACE
  STUDY_TIME
  EXERCISE_COUNT
  XP_RACE
  CUSTOM
}

enum ContestLobbyStatus {
  WAITING
  STARTED
  FINISHED
}

model ContestLobby {
  id              String                  @id
  title           String
  createdById     String                  @map("created_by_id")
  visibility      ContestLobbyVisibility  @default(PUBLIC)
  mode            ContestLobbyMode        @default(CUSTOM)
  targetValue     Int?
  
  status          ContestLobbyStatus      @default(WAITING)
  durationMinutes Int?                    @map("duration_minutes")
  startedAt       DateTime?               @map("started_at")
  endedAt         DateTime?               @map("ended_at")
  winnerId        String?                 @map("winner_id")
  results         Json?

  passwordHash    String?                 @map("password_hash")
  isActive        Boolean                 @default(true) @map("is_active")
  createdAt       DateTime                @default(now()) @map("created_at")
  participants    ContestLobbyParticipant[]
  messages        ContestLobbyMessage[]

  @@map("contest_lobbies")
}

model ContestLobbyParticipant {
  id        String           @id
  lobbyId   String           @map("lobby_id")
  userId    String           @map("user_id")
  role      ContestLobbyRole @default(MEMBER)
  joinedAt  DateTime         @default(now()) @map("joined_at")
  lobby     ContestLobby     @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, userId])
  @@map("contest_lobby_participants")
}

model ContestLobbyMessage {
  id        String       @id @default(uuid())
  lobbyId   String       @map("lobby_id")
  userId    String       @map("user_id")
  message   String
  createdAt DateTime     @default(now()) @map("created_at")
  lobby     ContestLobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("contest_lobby_messages")
  @@index([lobbyId])
}

model DailySnapshots {
  id                 String   @id
  userId             String   @map("user_id")
  date               DateTime @db.Date
  problemsSolved     Int      @default(0) @map("problems_solved")
  exercisesCompleted Int      @default(0) @map("exercises_completed")
  reviewsCompleted   Int      @default(0) @map("reviews_completed")
  minutesStudied     Int      @default(0) @map("minutes_studied")
  xpEarned           Int      @default(0) @map("xp_earned")
  streakMaintained   Boolean  @default(false) @map("streak_maintained")

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_snapshots")
}

model DiagnosticQuestions {
  id          String   @id
  track       String
  prompt      String
  topicName   String
  maxScore    Int      @default(10) @map("max_score")
  createdAt   DateTime @default(now()) @map("created_at")
  createdByAi Boolean  @default(true) @map("created_by_ai")
  version     Int      @default(1)

  @@index([track])
  @@map("diagnostic_questions")
}

model Editorials {
  id              String  @id
  problemId       String  @map("problem_id")
  content         String
  timeComplexity  String? @map("time_complexity")
  spaceComplexity String? @map("space_complexity")
  commonMistakes  Json?   @map("common_mistakes")
  problem         Problem @relation(fields: [problemId], references: [id])

  @@map("editorials")
}

model Events {
  id            String   @id
  userId        String   @map("user_id")
  eventType     String   @map("event_type")
  payload       Json
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id])

  @@map("events")
}

model ExerciseAttempt {
  id            String   @id
  userId        String   @map("user_id")
  exerciseId    String   @map("exercise_id")
  response      Json
  isCorrect     Boolean? @map("is_correct")
  score         Float?
  feedback      String?
  timeSpentSecs Int?     @map("time_spent_secs")
  hintsUsed     Int      @default(0) @map("hints_used")
  attemptNumber Int      @default(1) @map("attempt_number")
  createdAt     DateTime @default(now()) @map("created_at")
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("exercise_attempts")
}

model ExerciseHints {
  id         String   @id
  exerciseId String   @map("exercise_id")
  level      Int
  content    String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, level])
  @@map("exercise_hints")
}

model Exercise {
  id              String            @id
  subjectId       String            @map("subject_id")
  topicId         String?           @map("topic_id")
  type            ExerciseType
  title           String
  content         Json
  difficulty      Difficulty
  points          Int               @default(10)
  estimatedMins   Int?              @map("estimated_mins")
  tags            String[]          @default([])
  version         Int               @default(1)
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @map("updated_at")
  exerciseAttempts ExerciseAttempt[]
  exerciseHints   ExerciseHints[]
  contestExercises ContestExercise[]
  subject         Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topic           SubjectTopic?     @relation(fields: [topicId], references: [id])

  @@map("exercises")
}

model FailbackLogs {
  id         String   @id
  service    String
  fallbackTo String   @map("fallback_to")
  reason     String?
  userId     String?  @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("failback_logs")
}

model GraduationInterviews {
  id             String    @id
  userId         String    @map("user_id")
  roadmapId      String?   @map("roadmap_id")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  scores         Json?
  totalScore     Float?    @map("total_score")
  result         String?
  feedback       Json?
  integrityFlags Json?     @map("integrity_flags")
  integrityScore Float?    @map("integrity_score")
  transcript     Json?
  certificateId  String?   @map("certificate_id")

  @@map("graduation_interviews")
}

model HintLadders {
  id        String  @id
  problemId String  @map("problem_id")
  level     Int
  content   String
  problem   Problem @relation(fields: [problemId], references: [id])

  @@unique([problemId, level])
  @@map("hint_ladders")
}

model HomeworkAssignment {
  id                  String                @id
  userId              String                @map("user_id")
  roadmapId           String?               @map("roadmap_id")
  topicId             String?               @map("topic_id")
  title               String
  dueDate             DateTime              @map("due_date")
  isCompleted         Boolean               @default(false) @map("is_completed")
  completedAt         DateTime?             @map("completed_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  assignmentType      String                @default("general") @map("assignment_type")
  description         String?
  effectiveXpEarned   Int                   @default(0) @map("effective_xp_earned")
  estimatedMins       Int                   @default(30) @map("estimated_mins")
  lateDays            Int                   @default(0) @map("late_days")
  relatedExerciseId   String?               @map("related_exercise_id")
  subjectId           String?               @map("subject_id")
  xpReward            Int                   @default(50) @map("xp_reward")
  catchupQueues       CatchupQueues[]
  subject             Subject?              @relation(fields: [subjectId], references: [id])
  topic               SubjectTopic?         @relation(fields: [topicId], references: [id])
  homeworkReminders   HomeworkReminders[]
  homeworkSubmissions HomeworkSubmissions[]
  latePenalties       LatePenalties[]

  @@map("homework_assignments")
}

model HomeworkReminders {
  id                 String             @id
  homeworkId         String             @map("homework_id")
  reminderType       String             @map("reminder_type")
  scheduledFor       DateTime           @map("scheduled_for")
  sent               Boolean            @default(false)
  sentAt             DateTime?          @map("sent_at")
  homeworkAssignment HomeworkAssignment @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@map("homework_reminders")
}

model HomeworkSubmissions {
  id                 String             @id
  homeworkId         String             @map("homework_id")
  userId             String             @map("user_id")
  submissionType     String             @map("submission_type")
  fileName           String?            @map("file_name")
  fileType           String?            @map("file_type")
  content            String?
  fileUrl            String?            @map("file_url")
  aiFeedback         String?            @map("ai_feedback")
  aiScore            Float?             @map("ai_score")
  isGraded           Boolean            @default(false) @map("is_graded")
  gradedAt           DateTime?          @map("graded_at")
  submittedAt        DateTime           @default(now()) @map("submitted_at")
  homeworkAssignment HomeworkAssignment @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@map("homework_submissions")
}

model LatePenalties {
  id                 String             @id
  userId             String             @map("user_id")
  homeworkId         String             @map("homework_id")
  penaltyType        String             @map("penalty_type")
  severity           String             @default("light")
  applied            Boolean            @default(false)
  appliedAt          DateTime?          @map("applied_at")
  expiresAt          DateTime?          @map("expires_at")
  daysLate           Int                @default(0) @map("days_late")
  effectiveXp        Int                @default(0) @map("effective_xp")
  originalXp         Int                @default(0) @map("original_xp")
  penaltyPercent     Int                @default(0) @map("penalty_percent")
  homeworkAssignment HomeworkAssignment @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@map("late_penalties")
}

model LeaderboardSnapshots {
  id        String   @id
  type      String
  rankings  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@map("leaderboard_snapshots")
}

model LearningContracts {
  id                    String    @id
  userId                String    @map("user_id")
  signedAt              DateTime  @default(now()) @map("signed_at")
  complianceRate        Float     @default(100) @map("compliance_rate")
  goals                 Json      @default("[]")
  isActive              Boolean   @default(true) @map("is_active")
  subjectId             String    @map("subject_id")
  targetCompletionDate  DateTime? @map("target_completion_date")
  weeklyHoursCommitment Int       @map("weekly_hours_commitment")
  weeksCompliant        Int       @default(0) @map("weeks_compliant")
  subject               Subject   @relation(fields: [subjectId], references: [id])
  user                  User      @relation(fields: [userId], references: [id])

  @@map("learning_contracts")
}

model LearningMilestones {
  id            String   @id
  userId        String   @map("user_id")
  milestoneType String   @map("milestone_type")
  topicId       String?  @map("topic_id")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")
  topic         Topic?   @relation(fields: [topicId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@map("learning_milestones")
}

model LessonExercises {
  id       String  @id
  lessonId String  @map("lesson_id")
  type     String
  refId    String? @map("ref_id")
  order    Int
  lessons  Lessons @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("lesson_exercises")
}

model Lessons {
  id              String            @id
  moduleId        String            @map("module_id")
  title           String
  content         String
  order           Int
  lessonExercises LessonExercises[]
  modules         Modules           @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("lessons")
}

model MistakeCards {
  id               String      @id
  userId           String      @map("user_id")
  submissionId     String?     @map("submission_id")
  mistakeTag       String      @map("mistake_tag")
  category         String
  description      String?
  correctedConcept String?     @map("corrected_concept")
  occurrenceCount  Int         @default(1) @map("occurrence_count")
  lastOccurred     DateTime    @default(now()) @map("last_occurred")
  mastered         Boolean     @default(false)
  submission       Submission? @relation(fields: [submissionId], references: [id])
  user             User        @relation(fields: [userId], references: [id])

  @@map("mistake_cards")
}

model MistakeClosures {
  id            String   @id
  mistakeCardId String   @map("mistake_card_id")
  userId        String   @map("user_id")
  closureType   String   @map("closure_type")
  closureNote   String?  @map("closure_note")
  thenCode      String?  @map("then_code")
  nowCode       String?  @map("now_code")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("mistake_closures")
}

model MistakeReplays {
  id              String   @id
  mistakeCardId   String   @map("mistake_card_id")
  userId          String   @map("user_id")
  replayedAt      DateTime @default(now()) @map("replayed_at")
  newSubmissionId String?  @map("new_submission_id")
  wasSuccessful   Boolean  @default(false) @map("was_successful")

  @@map("mistake_replays")
}

model Modules {
  id             String    @id
  roadmapId      String    @map("roadmap_id")
  title          String
  order          Int
  passConditions Json?     @map("pass_conditions")
  lessons        Lessons[]
  roadmaps       Roadmaps  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@map("modules")
}

model OnboardingProfile {
  id                   String           @id @default(uuid())
  userId               String           @unique @map("user_id")
  status               OnboardingStatus @default(incomplete)
  track                String?
  goal                 String?
  hoursPerWeek         Int?             @map("hours_per_week")
  deadline             DateTime?
  difficultyPreference String?          @map("difficulty_preference")
  learningStyle        String?          @map("learning_style")
  aiPersona            String?          @map("ai_persona")
  diagnosticResponses  Json?
  baselineMastery      Json?            @map("baseline_mastery")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @map("updated_at")
  user                 User             @relation(fields: [userId], references: [id])

  @@map("onboarding_profiles")
}

model PersonalBests {
  id         String   @id
  userId     String   @map("user_id")
  category   String
  problemId  String?  @map("problem_id")
  value      Int
  achievedAt DateTime @default(now()) @map("achieved_at")
  problem    Problem? @relation(fields: [problemId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@map("personal_bests")
}

model PlateauAlerts {
  id            String   @id
  userId        String   @map("user_id")
  topicId       String?  @map("topic_id")
  alertType     String   @map("alert_type")
  severity      String   @default("medium")
  details       Json?
  strategyShift String?  @map("strategy_shift")
  acknowledged  Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId, acknowledged])
  @@map("plateau_alerts")
}

model PlatformHealth {
  id         String   @id
  service    String   @unique
  status     String   @default("healthy")
  lastCheck  DateTime @default(now()) @map("last_check")
  errorCount Int      @default(0) @map("error_count")
  message    String?

  @@map("platform_health")
}

model ProblemReports {
  id        String   @id
  userId    String?  @map("user_id")
  problemId String   @map("problem_id")
  reason    String
  details   String?
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")
  problem   Problem  @relation(fields: [problemId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@map("problem_reports")
}

model ProblemScratchpads {
  id        String   @id
  userId    String   @map("user_id")
  problemId String   @map("problem_id")
  notes     String   @default("")
  approach  String   @default("")
  updatedAt DateTime @map("updated_at")

  @@unique([userId, problemId])
  @@map("problem_scratchpads")
}

model ProblemSelections {
  id         String   @id
  userId     String   @map("user_id")
  problemId  String   @map("problem_id")
  reasons    Json
  selectedAt DateTime @default(now()) @map("selected_at")

  @@map("problem_selections")
}

model ProblemTopic {
  problemId String  @map("problem_id")
  topicId   String  @map("topic_id")
  problem   Problem @relation(fields: [problemId], references: [id])
  topic     Topic   @relation(fields: [topicId], references: [id])

  @@id([problemId, topicId])
  @@map("problem_topics")
}

model ProblemVersions {
  id                  String   @id
  problemId           String   @map("problem_id")
  version             Int
  descriptionSnapshot String?  @map("description_snapshot")
  createdAt           DateTime @default(now()) @map("created_at")
  problem             Problem  @relation(fields: [problemId], references: [id])

  @@map("problem_versions")
}

model Problem {
  id              String            @id
  title           String
  description     String
  difficulty      Difficulty
  status          ProblemStatus     @default(active)
  trustLabel      TrustLabel        @default(ai_validated) @map("trust_label")
  timeLimitMs     Int               @default(2000) @map("time_limit_ms")
  memoryLimitKb   Int               @default(256000) @map("memory_limit_kb")
  constraints     Json?
  version         Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at")
  contestProblems ContestProblems[]
  editorials      Editorials[]
  hintLadders     HintLadders[]
  personalBests   PersonalBests[]
  problemReports  ProblemReports[]
  topics          ProblemTopic[]
  problemVersions ProblemVersions[]
  starterTasks    StarterTasks[]
  submissions     Submission[]
