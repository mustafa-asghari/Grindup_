enum CardType {
  concept
  problem
  mistake
}

enum Difficulty {
  easy
  medium
  hard
}

enum ExerciseType {
  coding
  mcq
  flashcard
  fill_blank
  essay
  matching
  ordering
  diagram
  audio
  true_false
}

