# Core infrastructure
DATABASE_URL="postgresql://grindup:grindup_dev_only@localhost:5432/grindup"
REDIS_URL="redis://localhost:6379"

# ClickHouse
CLICKHOUSE_URL="http://localhost:8123"
CLICKHOUSE_USER="grindup"
CLICKHOUSE_PASSWORD="grindup_dev_only"
CLICKHOUSE_DB="grindup"

# Optional host-port overrides for Docker.
# Infra-only defaults: 5432, 6379, 8123, 9001, 5521.
# Full-stack Docker publishes the web app, a localhost-bound runner, and ClickHouse UI.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# CLICKHOUSE_HTTP_HOST_PORT=8123
# CLICKHOUSE_NATIVE_HOST_PORT=9001
# CLICKHOUSE_UI_HOST_PORT=15521
# RUNNER_HOST_PORT=8080

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-only-change-me"
AUTH_SECRET="dev-only-change-me"

# Optional OAuth providers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AI services
OPENAI_API_KEY=""
SERPER_API_KEY=""
YOUTUBE_API_KEY=""

# Optional LeetCode scrape headers. Leave empty unless you are running imports locally.
LEETCODE_API_URL="https://leetcode.com/graphql"
LEETCODE_CSRF_TOKEN=""
LEETCODE_COOKIE=""
SCRAPE_LIMIT="10000"
# Required to run POST /api/problems/scrape. Send as Authorization: Bearer <secret>.
PROBLEM_SCRAPE_SECRET=""

# Optional anti-bot protection
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET=""

# Runner service
RUNNER_URL="http://localhost:8080"
RUNNER_SHARED_SECRET="dev-only-runner-secret"
RUNNER_MAX_CONCURRENT_EXECUTIONS="2"
RUNNER_EXECUTION_QUEUE_TIMEOUT_MS="0"
